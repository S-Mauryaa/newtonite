generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  memberships     Membership[]
  createdItems    WorkItem[]       @relation("WorkItemCreator")
  assignedItems   WorkItem[]       @relation("WorkItemAssignee")
  activityEvents  ActivityEvent[]
  comments        Comment[]
  idempotencyKeys IdempotencyKey[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  workItems   WorkItem[]
}

model Membership {
  userId    String
  teamId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id             String           @id @default(cuid())
  title          String
  description    String           @default("")
  type           WorkItemType
  priority       WorkItemPriority @default(MEDIUM)
  status         WorkItemStatus   @default(OPEN)
  teamId         String
  assigneeId     String?
  createdById    String
  dueDate        DateTime?        @db.Timestamptz(3)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy      User             @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activityEvents ActivityEvent[]
  comments       Comment[]

  @@index([teamId, status, updatedAt, id])
  @@index([teamId, priority, updatedAt, id])
  @@index([teamId, type, updatedAt, id])
  @@index([assigneeId, status, updatedAt])
  @@index([teamId, dueDate, status])
}

model ActivityEvent {
  id            String   @id @default(cuid())
  workItemId    String
  actorId       String
  action        String
  previousValue String?
  newValue      String?
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  workItem      WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt, id])
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt, id])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String
  operation   String
  key         String
  fingerprint String
  response    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@index([createdAt])
}

model OutboxJob {
  id          String          @id @default(cuid())
  type        String
  payload     Json
  status      OutboxJobStatus @default(PENDING)
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  availableAt DateTime        @default(now()) @db.Timestamptz(3)
  processedAt DateTime?       @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
}
